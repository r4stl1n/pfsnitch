#!/bin/sh
# Close the pfsnitch panel, and cope with eww losing track of it.
#
# eww's window registry can desync from what is actually on screen: the surface
# is still displayed and the GTK loop is still running - the clock keeps
# ticking - but `eww close` answers "no such window was open" and the panel
# cannot be dismissed. That is the bug behind "the X does nothing".
#
# Nothing short of restarting the daemon destroys an orphaned surface, so if the
# close is refused, restart. That is heavy, but a panel you cannot close is
# worse, and it only happens when eww has already gone wrong.
set -u
PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin
export PATH

if [ "${PFSNITCH_DETACHED:-0}" != 1 ]; then
    PFSNITCH_DETACHED=1
    export PFSNITCH_DETACHED
    daemon -f "$0"
    exit 0
fi

out=$(eww close secpopup 2>&1)

# "no such window" alone is not proof of a desync - it is also the ordinary
# answer to a second click on an already-closed panel. The desync shows itself
# as a registry that has lost the BAR too, which never happens in normal use.
desync=no
case "$out" in
    *"Failed to connect"*) desync=yes ;;
    *"no such window"*)
        eww active-windows 2>/dev/null | grep -q '^bar' || desync=yes
        ;;
esac

case "$desync" in
    yes)
        logger -t pfsnitch-panel "eww lost the panel; restarting it"
        pkill -9 -f 'eww daemon'      >/dev/null 2>&1
        pkill -9 -f '^eww open'       >/dev/null 2>&1
        pkill -9 -f '^eww close'      >/dev/null 2>&1
        pkill -9 -f workspaces-listen >/dev/null 2>&1
        sleep 1
        eww daemon >/dev/null 2>&1 &
        sleep 3
        eww open bar >/dev/null 2>&1
        ;;
esac
