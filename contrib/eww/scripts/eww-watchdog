#!/bin/sh
# Keep eww alive.
#
# Restart eww if it becomes unreachable.
#
# Deliberately narrow. eww also has a separate fault - its window registry
# desyncs from what is on screen, so `eww close` answers "no such window" for a
# panel you are looking at - but the daemon is HEALTHY when that happens: the
# GTK loop still runs and the clock still ticks. Restarting on that symptom
# tears down a working bar for no reason, which is what an earlier version of
# this script did. That fault is handled in pfsnitch-close-panel, on the path
# where it is actually observable.
set -u
PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin
export PATH

INTERVAL=2
MISSES=0
THRESHOLD=2       # two in a row, so a restart in progress is not mistaken for a fault

start_eww() {
    # A crash strands whatever client was talking to the daemon, and orphans
    # the deflisten children it spawned. Left alone these accumulate: three
    # stuck `eww open` and four leaked listeners were sitting around after a
    # handful of crashes. Reap them, or the machine slowly fills with them.
    pkill -9 -f 'eww daemon'      >/dev/null 2>&1
    pkill -9 -f '^eww open'       >/dev/null 2>&1
    pkill -9 -f '^eww close'      >/dev/null 2>&1
    pkill -9 -f 'eww update'      >/dev/null 2>&1
    pkill -9 -f workspaces-listen >/dev/null 2>&1
    sleep 1
    eww daemon >/dev/null 2>&1 &
    sleep 3
    eww open bar >/dev/null 2>&1
}

while :; do
    sleep "$INTERVAL"

    if ! pgrep -f 'eww daemon' >/dev/null 2>&1; then
        logger -t eww-watchdog "daemon gone; restarting"
        start_eww
        MISSES=0
        continue
    fi

    # Only act when the daemon is genuinely unreachable. An earlier version
    # restarted whenever `active-windows` stopped listing the bar - but that
    # happens while the daemon is perfectly healthy and still rendering, so it
    # was killing a working bar every time the registry desynced. A panel that
    # will not close is handled on the close path instead, where the failure is
    # actually observable.
    if eww ping >/dev/null 2>&1; then
        MISSES=0
    else
        MISSES=$((MISSES + 1))
        if [ "$MISSES" -ge "$THRESHOLD" ]; then
            logger -t eww-watchdog "daemon unreachable; restarting"
            start_eww
            MISSES=0
        fi
    fi
done
